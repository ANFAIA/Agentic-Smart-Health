#!/usr/bin/env bash
#
# pre-commit — dos guardianes, con criterios distintos a propósito.
#
#   1. data_guard.py   BLOQUEA. Un dato ajeno que entra al commit ya está en la
#      historia de git, y sacarlo obliga a reescribirla (issue 45: filter-repo +
#      force-push por 156 MiB de PDF). Aquí es más barato que en ningún otro sitio.
#
#   2. docs_sync.py    NO bloquea. Regenera lo que es copia mecánica del código
#      (tablas de variables, scripts, comandos de make, registro de agentes) y lo
#      añade AL MISMO COMMIT, para que la documentación viaje con el cambio que la
#      afecta. Si falla, avisa y deja commitear: el CI lo dirá en la PR. Un hook
#      que impide trabajar por un problema de documentación acaba desinstalado.
#
# Solo toca los bloques entre marcas: la prosa no se toca nunca.
# Para saltárselo puntualmente: git commit --no-verify
set -euo pipefail

raiz="$(git rev-parse --show-toplevel)"
cd "$raiz"

# --- 1. Datos y licencias -------------------------------------------------- #
# Mira el índice (`git ls-files` ya ve lo que está en stage), así que el fichero
# se caza antes de existir el commit.
if ! salida="$(uv run python scripts/data_guard.py --quiet 2>&1)"; then
  echo "$salida" >&2
  echo >&2
  echo "pre-commit: commit detenido. Lo de arriba entra en la historia de git y" >&2
  echo "no se puede quitar sin reescribirla. Si de verdad tiene que ir, quita el" >&2
  echo "fichero del stage o razona la excepción en scripts/data_guard.py." >&2
  exit 1
fi

# --- 2. Bloques generados de la documentación ------------------------------ #
#
# Se fotografía el contenido ANTES de regenerar y se comparan las huellas después:
# así se añade solo lo que docs_sync haya tocado DURANTE esta ejecución.
#
# La versión anterior usaba `git diff --name-only -- README.md AGENTS.md`, que lista
# lo modificado respecto al índice **por cualquier motivo**. El 2026-08-10 eso se
# tragó ediciones de prosa que iban a otro commit: una tanda de nueve quedó en siete,
# con la documentación adelantada al código que describía. El comentario de entonces
# ya prometía «solo los que el script haya cambiado»; el código no lo cumplía.
DOCS_GENERADOS=(README.md AGENTS.md)

declare -A huella_previa
for doc in "${DOCS_GENERADOS[@]}"; do
  huella_previa["$doc"]="$(git hash-object "$doc")"
done

uv run python scripts/docs_sync.py --write >/dev/null 2>&1 || {
  echo "pre-commit: docs_sync.py falló; se commitea igual y el CI lo dirá." >&2
  exit 0
}

regenerados=()
for doc in "${DOCS_GENERADOS[@]}"; do
  if [ "$(git hash-object "$doc")" != "${huella_previa["$doc"]}" ]; then
    regenerados+=("$doc")
  fi
done

if [ ${#regenerados[@]} -gt 0 ]; then
  git add "${regenerados[@]}"
  echo "pre-commit: bloques generados actualizados y añadidos al commit:"
  printf '  · %s\n' "${regenerados[@]}"
fi
