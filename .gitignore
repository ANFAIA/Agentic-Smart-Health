# =============================================================================
# Agentic Smart Health — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
MANIFEST

# -----------------------------------------------------------------------------
# Entornos virtuales
# -----------------------------------------------------------------------------
.venv/
venv/
env/
.env/

# -----------------------------------------------------------------------------
# uv
# -----------------------------------------------------------------------------
.uv/

# -----------------------------------------------------------------------------
# Variables de entorno y secretos
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.secret
*.key
secrets/

# -----------------------------------------------------------------------------
# Datos clínicos y archivos sensibles
# -----------------------------------------------------------------------------
# NO se versionan por tres motivos: (1) pesan (mallas/volúmenes de varios GB),
# (2) reproducibilidad — se regeneran desde su origen, no se guardan en git:
#     - data/raw/       = dataset de origen  -> scripts/fetch_teeth3ds.sh
#     - data/processed/ = artefactos derivados (.ply, vistas, transforms.json)
#                         -> los generan los notebooks/ al ejecutarse
#     - data/external/  = terceros
#     - data/interim/   = salidas de la ingesta (ArtifactStore .npz, cuarentena)
#                         -> las genera apps/agent-orchestrator al ejecutarse
# (3) licencia/soberanía del dato: no redistribuir datos clínicos vía el repo.
data/raw/
data/processed/
data/external/
# Solo el contenido: se conserva el .gitkeep para que el directorio exista.
data/interim/*
!data/interim/.gitkeep
*.dcm
*.nii
*.nii.gz
*.nrrd
*.mha
*.mhd
*.mnc
*.img
*.hdr
# Mallas: las produce cualquier paso de Blender/VTK y son un derivado del dato
# clínico igual que el volumen del que salen. `scripts/data_guard.py` comprueba
# que estas reglas siguen vivas.
*.stl
*.obj
*.glb
*.gltf

# -----------------------------------------------------------------------------
# Jupyter Notebooks
# -----------------------------------------------------------------------------
notebooks/.ipynb_checkpoints/
.ipynb_checkpoints/
*.ipynb_checkpoints

# -----------------------------------------------------------------------------
# Testing y cobertura
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# -----------------------------------------------------------------------------
# Linting y type checking
# -----------------------------------------------------------------------------
.ruff_cache/
.mypy_cache/

# -----------------------------------------------------------------------------
# IDEs y editores
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# macOS / Windows
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# Logs y temporales
# -----------------------------------------------------------------------------
*.log
*.tmp
*.bak
tmp/
temp/

# -----------------------------------------------------------------------------
# Qdrant vector database (research-agent)
# -----------------------------------------------------------------------------
# La knowledge base del research-agent: PDF de terceros. 156 MiB, y 9 de los 17
# con licencia que NO permite redistribuirlos (arXiv perpetual, actas de AAAI,
# CC BY-NC-ND, informes sin licencia). Lo que se versiona es el inventario
# (`manifest.yaml`); los ficheros se materializan con
# `uv run python scripts/fetch_knowledge_base.py`.
data/research-agent/knowledge_base/*
!data/research-agent/knowledge_base/.gitkeep
!data/research-agent/knowledge_base/manifest.yaml
data/research-agent/.qdrant_data/

# -----------------------------------------------------------------------------
# Modelos y artefactos grandes (3DGS, ML)
# -----------------------------------------------------------------------------
*.ply
*.splat
*.ckpt
*.pt
*.pth
*.safetensors
.claude/settings.local.json

# -----------------------------------------------------------------------------
# Trabajo exploratorio que NO se publica
# -----------------------------------------------------------------------------
# Estas reglas tienen que quedarse aunque no haya nada en el arbol: son lo que
# impide que un `git add .` suba material derivado de datasets cuya licencia no
# permite redistribuirlo (o cuya descarga exige aceptar un acuerdo de uso). Los
# hallazgos que sí son publicables viven en docs/research/, escritos como texto.
experiments/
notebooks/08-*.ipynb
.gstack/

# Visores 3D generados por los notebooks: son geometria de paciente (decenas de MB de
# malla por fichero) y derivados regenerables. Nunca al repositorio.
notebooks/visores/
