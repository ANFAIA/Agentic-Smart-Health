{
  "$defs": {
    "Acquisition": {
      "additionalProperties": false,
      "properties": {
        "time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time"
        },
        "device": {
          "$ref": "#/$defs/Device"
        }
      },
      "title": "Acquisition",
      "type": "object",
      "description": "When an asset was captured, and on what equipment."
    },
    "AnatomicalConvention": {
      "description": "Axis convention of a frame. Handedness fixes chirality, not orientation.",
      "enum": [
        "LPS",
        "RAS",
        "device"
      ],
      "title": "AnatomicalConvention",
      "type": "string"
    },
    "Asset": {
      "additionalProperties": false,
      "description": "One file or directory the container carries or references.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "visit": {
          "title": "Visit",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "frame": {
          "title": "Frame",
          "type": "string"
        },
        "acquisition": {
          "$ref": "#/$defs/Acquisition"
        },
        "load_priority": {
          "default": 30,
          "title": "Load Priority",
          "type": "integer"
        },
        "regulatory": {
          "$ref": "#/$defs/Regulatory"
        },
        "projection": {
          "anyOf": [
            {
              "$ref": "#/$defs/Projection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/Part"
          },
          "title": "Parts",
          "type": "array"
        },
        "sidecar_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sidecar Uri"
        },
        "derived_from": {
          "items": {
            "type": "string"
          },
          "title": "Derived From",
          "type": "array"
        },
        "series_instance_uid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series Instance Uid"
        },
        "study_instance_uid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Study Instance Uid"
        },
        "external": {
          "default": false,
          "title": "External",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "visit",
        "uri",
        "media_type",
        "sha256",
        "bytes",
        "frame"
      ],
      "title": "Asset",
      "type": "object"
    },
    "Clearance": {
      "additionalProperties": false,
      "description": "What one jurisdiction says about this asset.",
      "properties": {
        "jurisdiction": {
          "title": "Jurisdiction",
          "type": "string"
        },
        "regime": {
          "title": "Regime",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ClearanceStatus"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        }
      },
      "required": [
        "jurisdiction",
        "regime",
        "status"
      ],
      "title": "Clearance",
      "type": "object"
    },
    "AssetKind": {
      "description": "What kind of thing an asset is.",
      "enum": [
        "volume",
        "mesh_gs_scene",
        "image2d",
        "signal",
        "derived_seg",
        "document"
      ],
      "title": "AssetKind",
      "type": "string"
    },
    "Consent": {
      "additionalProperties": false,
      "description": "What the patient consented to, which bounds purpose of use.",
      "properties": {
        "fhir_consent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fhir Consent"
        },
        "scope": {
          "items": {
            "$ref": "#/$defs/PurposeOfUse"
          },
          "title": "Scope",
          "type": "array"
        },
        "obtained": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Obtained"
        }
      },
      "title": "Consent",
      "type": "object"
    },
    "Deidentification": {
      "additionalProperties": false,
      "description": "What was done to de-identify, in the vocabulary of DICOM PS3.15 Annex E.",
      "properties": {
        "profile": {
          "title": "Profile",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "applied_to": {
          "items": {
            "type": "string"
          },
          "title": "Applied To",
          "type": "array"
        },
        "tool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tool"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "date_shift_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Shift Days"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "profile"
      ],
      "title": "Deidentification",
      "type": "object"
    },
    "Device": {
      "additionalProperties": false,
      "description": "The equipment, with fixed keys and no serial number.",
      "properties": {
        "manufacturer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manufacturer"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "software_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Software Version"
        }
      },
      "title": "Device",
      "type": "object"
    },
    "PHIState": {
      "description": "Explicit PHI state. No value of it makes a container non-personal data.",
      "enum": [
        "identified",
        "pseudonymized",
        "anonymized",
        "quarantined"
      ],
      "title": "PHIState",
      "type": "string"
    },
    "ClearanceStatus": {
      "description": "Closed vocabulary for a clearance status.",
      "enum": [
        "not_a_device",
        "investigational",
        "submitted",
        "cleared",
        "withdrawn"
      ],
      "title": "ClearanceStatus",
      "type": "string"
    },
    "Extension": {
      "additionalProperties": false,
      "description": "A format extension the container declares and may require.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        },
        "schema_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Id"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "Extension",
      "type": "object"
    },
    "Frame": {
      "additionalProperties": false,
      "description": "A coordinate system in which asset positions are expressed.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "units": {
          "default": "mm",
          "title": "Units",
          "type": "string"
        },
        "handedness": {
          "default": "right",
          "title": "Handedness",
          "type": "string"
        },
        "anatomical": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnatomicalConvention"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dicom_frame_of_reference_uid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dicom Frame Of Reference Uid"
        }
      },
      "required": [
        "id"
      ],
      "title": "Frame",
      "type": "object"
    },
    "Tool": {
      "additionalProperties": false,
      "description": "The program that applied the de-identification.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "name"
      ],
      "title": "Tool",
      "type": "object"
    },
    "Part": {
      "additionalProperties": false,
      "description": "One file inside an asset that is a directory, such as a DICOM slice.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "sop_instance_uid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sop Instance Uid"
        },
        "pixel_data_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pixel Data Sha256"
        }
      },
      "required": [
        "name",
        "sha256",
        "bytes"
      ],
      "title": "Part",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "The append-only hash chain linking versions of this case.",
      "properties": {
        "prev_manifest_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prev Manifest Sha256"
        },
        "chain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chain"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "PurposeOfUse": {
      "description": "Closed vocabulary for what a container was issued for.",
      "enum": [
        "treatment",
        "lab_manufacturing",
        "second_opinion",
        "research",
        "model_training"
      ],
      "title": "PurposeOfUse",
      "type": "string"
    },
    "Projection": {
      "additionalProperties": false,
      "description": "What kind of 2D image an asset is, and which teeth it targets.",
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "fdi_targets": {
          "items": {
            "type": "string"
          },
          "title": "Fdi Targets",
          "type": "array"
        }
      },
      "required": [
        "type"
      ],
      "title": "Projection",
      "type": "object"
    },
    "FHIRResource": {
      "additionalProperties": false,
      "description": "Which FHIR R4 resource an asset corresponds to.",
      "properties": {
        "resource_type": {
          "title": "Resource Type",
          "type": "string"
        },
        "resource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "resource_type"
      ],
      "title": "FHIRResource",
      "type": "object"
    },
    "Registration": {
      "additionalProperties": false,
      "description": "A rigid transform taking points from one frame to another.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source_frame": {
          "title": "Source Frame",
          "type": "string"
        },
        "target_frame": {
          "title": "Target Frame",
          "type": "string"
        },
        "transform_4x4_row_major": {
          "items": {
            "type": "number"
          },
          "maxItems": 16,
          "minItems": 16,
          "title": "Transform 4X4 Row Major",
          "type": "array"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "rms_error_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rms Error Mm"
        },
        "computed": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Computed"
        },
        "operator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator"
        },
        "verified_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified By"
        },
        "regulatory": {
          "anyOf": [
            {
              "$ref": "#/$defs/Regulatory"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "source_frame",
        "target_frame",
        "transform_4x4_row_major",
        "method"
      ],
      "title": "Registration",
      "type": "object"
    },
    "Regulatory": {
      "additionalProperties": false,
      "description": "The regulatory layer of an asset and its clearances.",
      "properties": {
        "layer": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Layer",
          "type": "integer"
        },
        "clearances": {
          "items": {
            "$ref": "#/$defs/Clearance"
          },
          "title": "Clearances",
          "type": "array"
        }
      },
      "title": "Regulatory",
      "type": "object"
    },
    "Subject": {
      "additionalProperties": false,
      "description": "The patient, always by pseudonym.",
      "properties": {
        "pseudonym": {
          "title": "Pseudonym",
          "type": "string"
        },
        "fhir_patient": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fhir Patient"
        },
        "consent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Consent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "pseudonym"
      ],
      "title": "Subject",
      "type": "object"
    },
    "Visit": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "date": {
          "title": "Date",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "date"
      ],
      "title": "Visit",
      "type": "object",
      "description": "One clinical encounter the assets belong to."
    }
  },
  "additionalProperties": false,
  "description": "The manifest of a Unified Oral Scene container. Derived from the reference implementation's contract rather than written by hand: a schema copied by hand diverges from the code at the first field somebody adds.",
  "properties": {
    "uos_version": {
      "default": "0.2",
      "title": "Uos Version",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "created": {
      "format": "date-time",
      "title": "Created",
      "type": "string"
    },
    "generator": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Generator",
      "type": "object"
    },
    "phi_state": {
      "$ref": "#/$defs/PHIState"
    },
    "deidentification": {
      "anyOf": [
        {
          "$ref": "#/$defs/Deidentification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "purpose_of_use": {
      "anyOf": [
        {
          "$ref": "#/$defs/PurposeOfUse"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "subject": {
      "$ref": "#/$defs/Subject"
    },
    "canonical_frame": {
      "$ref": "#/$defs/Frame"
    },
    "frames": {
      "items": {
        "$ref": "#/$defs/Frame"
      },
      "title": "Frames",
      "type": "array"
    },
    "visits": {
      "items": {
        "$ref": "#/$defs/Visit"
      },
      "title": "Visits",
      "type": "array"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Assets",
      "type": "array"
    },
    "registrations": {
      "items": {
        "$ref": "#/$defs/Registration"
      },
      "title": "Registrations",
      "type": "array"
    },
    "fhir_map": {
      "additionalProperties": {
        "$ref": "#/$defs/FHIRResource"
      },
      "title": "Fhir Map",
      "type": "object"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/Extension"
      },
      "title": "Extensions",
      "type": "object"
    },
    "extensions_used": {
      "items": {
        "type": "string"
      },
      "title": "Extensions Used",
      "type": "array"
    },
    "extensions_required": {
      "items": {
        "type": "string"
      },
      "title": "Extensions Required",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "case_id",
    "generator",
    "phi_state",
    "subject",
    "canonical_frame"
  ],
  "title": "UOS manifest v0.2",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ANFAIA/Agentic-Smart-Health/uos-spec-v0.2/schemas/uos-manifest-0.2.schema.json"
}
