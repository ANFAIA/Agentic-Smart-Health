# Variables de entorno del proyecto — copia este fichero a `.env` y rellena lo que
# necesites. Aquí solo están las que el código lee de verdad: cada una lleva quién
# la usa y qué pasa si no se define.
#
# Ninguna hace falta para ejecutar la suite de pruebas (`make test`).

# --------------------------------------------------------------------------- #
# research-agent  ·  apps/research-agent
# --------------------------------------------------------------------------- #
# Clave de Anthropic. Necesaria SOLO para el modo Claude
# (`uv run python -m src.main`) y para el `report-agent` cuando resume informes.
# El modo local con Ollama (`uv run python -m src.main_local`) no necesita ninguna
# clave: si solo vas a usar ese, deja esto vacío.
ANTHROPIC_API_KEY=

# Modelo de Claude del CLI. Sin definir usa el valor por defecto de `src/main.py`.
RESEARCH_AGENT_MODEL=

# Modo local: modelo de Ollama y dónde escucha.
# Por defecto: `qwen2.5:7b` y `http://localhost:11434`.
RESEARCH_AGENT_LOCAL_MODEL=
OLLAMA_HOST=

# Dónde persiste la base vectorial de la ingesta RAG.
# Por defecto: `data/research-agent/.qdrant_data/` (gitignorado).
QDRANT_PATH=

# --------------------------------------------------------------------------- #
# ingestion-agents  ·  packages/ingestion-agents
# --------------------------------------------------------------------------- #
# Sal del seudónimo de paciente que aplica el `cbct-agent` al anonimizar.
#
# Sin definirla se usa `dev-salt-no-usar-en-produccion`, que es exactamente lo que
# su nombre dice: sirve para desarrollo y NO para datos reales. En producción hace
# falta una sal larga, aleatoria y **estable**: si cambia, los seudónimos dejan de
# coincidir con los ya emitidos y se pierde la trazabilidad entre estudios del
# mismo paciente. Trátala como un secreto — quien la tenga puede recalcular
# seudónimos a partir de identificadores.
ASH_PSEUDONYM_SALT=

# Modelo de Ollama del backend `ollama` del `report-agent`.
#
# Por defecto: `qwen3:14b`. Solo se usa con `--backend ollama`; el backend por
# defecto (`rules`) es determinista y no necesita ni red ni modelo. Existe porque
# en la única modalidad de prosa libre —el informe— que el texto no salga de la
# máquina pesa más que el coste, y `OLLAMA_HOST` (arriba) dice dónde escucha.
REPORT_AGENT_LOCAL_MODEL=
